{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "App: dev mode",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "App: profile mode",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "App: release mode",
            "cwd": "mobile",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "Web: dev server",
            "cwd": "${workspaceFolder}/web",
            "request": "launch",
            "type": "node-terminal",
            "command": "npm run dev"
        },
        {
            "name": "Firebase: deploy all",
            "cwd": "${workspaceFolder}/backend",
            "request": "launch",
            "type": "node-terminal",
            "command": "firebase deploy"
        },
        {
            "name": "Firebase: deploy functions",
            "cwd": "${workspaceFolder}/backend",
            "request": "launch",
            "type": "node-terminal",
            "command": "firebase deploy --only functions:backend"
        }
    ]
}